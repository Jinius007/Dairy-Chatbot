# Dairy Chatbot — Vercel
# Copy to .env.local for local dev

# Frontend API base (same-origin on Vercel; optional — defaults to /api)
VITE_API_URL=/api

# Chat LLM — Sarvam (required for text replies)
# SARVAM_API_KEY=
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_CALL_CHAT_MODEL=sarvam-105b-conversations

# Voice: browser Web Speech STT/TTS by default (no API key).
# VITE_USE_BROWSER_VOICE=false

# Local dev: copy to .env.local and set SARVAM_API_KEY there (never commit the key).
# API_SERVE_URL=http://localhost:3000

# Optional
# BHASHINI_API_KEY=
# YOUTUBE_API_KEY=

# Optional conversation logging (Supabase)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional vet portal Google sign-in
# VITE_GOOGLE_CLIENT_ID=

# Optional Vobiz phone calls
# VOBIZ_AUTH_ID=
# VOBIZ_AUTH_TOKEN=
# VITE_VOBIZ_PHONE_NUMBER=
