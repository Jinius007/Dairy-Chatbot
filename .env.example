# Dairy Chatbot — Vercel
# Copy to .env.local for local dev

# Frontend API base (same-origin on Vercel; optional — defaults to /api)
VITE_API_URL=/api

# Chat LLM — Google Gemini (free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# Voice: browser Web Speech STT/TTS by default (no API key). Set false to use server /transcribe + /tts.
# VITE_USE_BROWSER_VOICE=false

# Local dev: run `npm run serve:api` on port 3000, Vite proxies /api
# API_SERVE_URL=http://localhost:3000

# Optional server TTS fallback (Bhashini / Google scrape — no Sarvam)
# BHASHINI_API_KEY=optional
# YOUTUBE_API_KEY=optional

# Legacy Sarvam (only if re-enabling server STT/transliterate)
# SARVAM_API_KEY=

# Optional conversation logging (Supabase)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional vet portal Google sign-in
# VITE_GOOGLE_CLIENT_ID=

# Optional Vobiz phone calls
# VOBIZ_AUTH_ID=
# VOBIZ_AUTH_TOKEN=
# VITE_VOBIZ_PHONE_NUMBER=
