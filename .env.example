# Dairy Chatbot — Vercel + Sarvam AI
# Copy to .env.local for local dev

# Frontend API base (same-origin on Vercel; optional — defaults to /api)
VITE_API_URL=/api

# Local dev: run `npm run serve:api` on port 3000, Vite proxies /api
# API_SERVE_URL=http://localhost:3000

# Server secrets (Vercel → Project Settings → Environment Variables)
# SARVAM_API_KEY=required
# SARVAM_CHAT_MODEL=sarvam-30b
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TTS_SPEAKER=suhani
# BHASHINI_API_KEY=optional
# YOUTUBE_API_KEY=optional

# Optional conversation logging (Supabase)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional vet portal Google sign-in
# VITE_GOOGLE_CLIENT_ID=

# Optional Vobiz phone calls
# VOBIZ_AUTH_ID=
# VOBIZ_AUTH_TOKEN=
# VITE_VOBIZ_PHONE_NUMBER=
